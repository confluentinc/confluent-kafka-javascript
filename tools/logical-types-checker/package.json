{
  "name": "@cflt-internal/logical-types-checker",
  "version": "0.1.0",
  "description": "Syntax checker for the LogicalTypes DDL grammar, usable as an embeddable module or via the browser demo page.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "bash scripts/generate-parser.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:demo": "esbuild demo/main.ts --bundle --outfile=demo/bundle.js --format=iife",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "antlr-ng": "1.0.10",
    "esbuild": "^0.24.0",
    "typescript": "5.9.3"
  }
}
